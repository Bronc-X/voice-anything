<Window
    x:Class="SayAll.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SayAll.Windows"
    Title="Voice Anything"
    Width="1120"
    Height="760"
    Icon="Resources/VoiceAnything.ico"
    MinWidth="980"
    MinHeight="680"
    Background="{StaticResource WindowBrush}"
    FontFamily="Microsoft YaHei UI"
    Foreground="{StaticResource TextBrush}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SpectrumPaletteSelectorStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="PaletteBar"
                                Width="12"
                                Height="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Opacity="0.28" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PaletteBar" Property="Width" Value="22" />
                                <Setter TargetName="PaletteBar" Property="Height" Value="4" />
                                <Setter TargetName="PaletteBar" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PaletteBar" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PaletteBar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="设备与型号" Click="OpenDevices_Click" Margin="0,0,10,0" />
                    <Button Content="统计 · 回眸 · Agent" Click="OpenHistory_Click" />
                </StackPanel>
                <StackPanel><TextBlock Text="Voice Anything" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HistoryStatusText" Text="先连接设备，再设置按键" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </DockPanel>
        </Border>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="36,8,36,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="RemoteStepButton"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnboardingStep_Click"
                    Content="连接遥控器"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"
                    Tag="Remote" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Text="›" />
                <Button
                    x:Name="AudioStepButton"
                    Grid.Column="2"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnboardingStep_Click"
                    Content="设置录音"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Tag="Audio" />
                <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Text="›" />
                <Button
                    x:Name="VoiceStepButton"
                    Grid.Column="4"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnboardingStep_Click"
                    Content="验证语音"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Tag="VoiceTest" />
                <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Text="›" />
                <Button
                    x:Name="ControlsStepButton"
                    Grid.Column="6"
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnboardingStep_Click"
                    Content="测试按键"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Tag="Controls" />
            </Grid>
            <Grid Grid.Row="1">
                <Border Background="#DCE3EA" CornerRadius="2" />
                <Border x:Name="OnboardingProgress" Width="250" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="2" />
            </Grid>
        </Grid>

        <Grid x:Name="RemoteStep" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="53*" />
                <ColumnDefinition Width="47*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="48,30,42,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,9"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentBrush}"
                        Text="第 1 步 · RC003MS" />
                    <TextBlock
                        MaxWidth="520"
                        FontSize="30"
                        FontWeight="SemiBold"
                        LineHeight="39"
                        Text="连接并确认你的遥控器"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxWidth="520"
                        Margin="0,12,0,0"
                        FontSize="15"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        LineHeight="24"
                        Text="先确认 Windows 已连接“MI RC”，再按一次任意方向键。只有收到真实按键报告后，才会进入录音设置。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,28,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="{StaticResource SuccessSoftBrush}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource SuccessBrush}" Text="&#xE702;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedDeviceTitle" FontSize="15" FontWeight="SemiBold" Text="请选择设备与型号" />
                                <TextBlock x:Name="ConnectionDetail" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="正在检查 Windows 蓝牙连接…" />
                            </StackPanel>
                            <Border
                                x:Name="ConnectionBadge"
                                Grid.Column="2"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Background="{StaticResource PendingSoftBrush}"
                                CornerRadius="12">
                                <TextBlock x:Name="ConnectionBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PendingBrush}" Text="检查中" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource AccentBrush}" Text="&#xE765;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="真实按键测试" />
                                <TextBlock x:Name="ButtonDetail" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="连接完成后，请按一次任意方向键" />
                            </StackPanel>
                            <Border x:Name="ButtonStateDot" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Background="#B7C0CA" CornerRadius="5" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="EnableButtonTestButton"
                            Margin="0,0,8,0"
                            Click="EnableButtonTest_Click"
                            Content="启用按键测试"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Margin="0,0,8,0" Click="OpenBluetoothSettings_Click" Content="打开蓝牙设置" />
                        <Button Margin="0,0,8,0" Click="RefreshConnection_Click" Content="重新检测" />
                        <Button Margin="0,0,8,0" Click="OpenAudioTest_Click" Content="直接测试录音" />
                        <Button Click="OpenControlsSettings_Click" Content="直接设置按键" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="按键测试会自动连接 Voice Anything 后台组件，不会弹出命令行窗口。" />
                    <Button
                        x:Name="ContinueButton"
                        Grid.Column="1"
                        MinWidth="126"
                        Click="ContinueButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="下一步  →" />
                </Grid>
            </Grid>

            <Border
                Grid.Column="1"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid Margin="26,22,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="176" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Ellipse Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#100F6CBD" />
                        <Ellipse Width="205" Height="205" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#120F6CBD" />
                        <Image
                            x:Name="HomeDeviceImage"
                            Width="176"
                            Height="366"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="pack://application:,,,/VoiceAnything;component/Resources/RC003MS-remote-front-v2.png"
                            Stretch="Uniform">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.16" ShadowDepth="9" />
                            </Image.Effect>
                        </Image>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="#070405"
                        BorderBrush="#3A1814"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="18">
                        <Grid>
                            <local:LiveVoiceSpectrum x:Name="HomeVoiceSpectrum" Height="156" VerticalAlignment="Bottom" Opacity="0.98" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#D00A0607" />
                                        <GradientStop Offset="0.28" Color="#200A0607" />
                                        <GradientStop Offset="1" Color="#000A0607" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="16,13,16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HomeSpectrumLiveDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#6F4A45" />
                                        <TextBlock FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#F3C1A0" Text="RC003MS / LIVE PCM" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="#9C7168" Text="16 kHz · 24 BAND" />
                                        <Border Width="1" Height="11" Margin="10,0,6,0" VerticalAlignment="Center" Background="#3A2727" />
                                        <RadioButton
                                            x:Name="SpectrumPaletteBlue"
                                            AutomationProperties.Name="蓝色频谱"
                                            Background="#126BFF"
                                            Checked="SpectrumPalette_Checked"
                                            GroupName="SpectrumPalette"
                                            Style="{StaticResource SpectrumPaletteSelectorStyle}"
                                            Tag="Blue"
                                            ToolTip="蓝色频谱" />
                                        <RadioButton
                                            x:Name="SpectrumPaletteEmber"
                                            AutomationProperties.Name="火焰红频谱"
                                            Background="#F13A12"
                                            Checked="SpectrumPalette_Checked"
                                            GroupName="SpectrumPalette"
                                            Style="{StaticResource SpectrumPaletteSelectorStyle}"
                                            Tag="Ember"
                                            ToolTip="火焰红频谱" />
                                        <RadioButton
                                            x:Name="SpectrumPaletteEmerald"
                                            AutomationProperties.Name="荧光绿频谱"
                                            Background="#10D96B"
                                            Checked="SpectrumPalette_Checked"
                                            GroupName="SpectrumPalette"
                                            Style="{StaticResource SpectrumPaletteSelectorStyle}"
                                            Tag="Emerald"
                                            ToolTip="荧光绿频谱" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="HomeSpectrumPeak" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#FFF0D4" Text="— dB" />
                                <TextBlock x:Name="HomeSpectrumStatus" Grid.Row="2" FontSize="11" Foreground="#C59582" Text="按录音键开始 · 真实声音会在这里流动" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AudioStep" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*" />
                <ColumnDefinition Width="42*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="48,30,42,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Margin="0,0,0,9" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="第 2 步 · 设置录音" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" LineHeight="39" Text="让遥控器声音进入 Windows" TextWrapping="Wrap" />
                    <TextBlock MaxWidth="570" Margin="0,12,0,0" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" LineHeight="24" Text="Voice Anything 会连接所选设备的语音服务，将 16 kHz 音频送入 VB-CABLE。按住麦克风键开始录音，松开停止。" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,28,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource AccentBrush}" Text="&#xE8D6;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Windows 录音入口" />
                                <TextBlock x:Name="AudioOutputDetail" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="正在查找 VB-CABLE…" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border x:Name="AudioOutputDot" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Background="#B7C0CA" CornerRadius="5" />
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" VerticalAlignment="Top" Background="{StaticResource AccentSoftBrush}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource AccentBrush}" Text="&#xE774;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="录音时使用的输入法" />
                                    <Button
                                        x:Name="RefreshVoiceInputsButton"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Click="RefreshVoiceInputs_Click"
                                        ToolTip="刷新状态">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE72C;" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="0,3,0,7" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="选择后自动记住" />
                                <TextBlock
                                    x:Name="InputMethodStatus"
                                    Margin="2,0,0,7"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="请选择一个输入法"
                                    TextWrapping="Wrap" />
                                <ListBox
                                    x:Name="InputMethodListBox"
                                    MaxHeight="224"
                                    BorderThickness="0"
                                    SelectionChanged="InputMethod_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="43" Margin="2,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Profile.DisplayName}" />
                                                    <TextBlock Margin="0,2,10,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Readiness.StatusText}" />
                                                </StackPanel>
                                                <Button
                                                    x:Name="VoiceInputTestButton"
                                                    Grid.Column="1"
                                                    MinWidth="88"
                                                    Margin="8,0,0,0"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center"
                                                    Content="按住测试"
                                                    IsEnabled="{Binding Readiness.CanTest}"
                                                    PreviewMouseLeftButtonDown="VoiceInputTest_PreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="VoiceInputTest_PreviewMouseLeftButtonUp"
                                                    Tag="{Binding Profile}"
                                                    ToolTip="{Binding Readiness.StatusText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBox
                                    x:Name="VoiceInputTestTextBox"
                                    MinHeight="48"
                                    Margin="2,7,0,0"
                                    Padding="8,6"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    ToolTip="测试听写文字会出现在这里" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="{StaticResource SuccessSoftBrush}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource SuccessBrush}" Text="&#xE702;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="遥控器语音服务" />
                                <TextBlock x:Name="AudioStatusText" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="等待连接…" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="AudioStatusDot" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Background="#B7C0CA" CornerRadius="5" />
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="21">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource AccentBrush}" Text="&#xE720;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="真机语音测试" />
                                <TextBlock x:Name="VoiceTestDetail" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="连接完成后，按住麦克风键说话" TextWrapping="Wrap" />
                                <ProgressBar x:Name="VoiceLevelMeter" Height="5" Margin="0,8,0,0" Maximum="100" Value="0" />
                            </StackPanel>
                            <Border x:Name="VoiceStateDot" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Background="#B7C0CA" CornerRadius="5" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AudioRetryButton" Width="126" Margin="0,0,8,0" Click="RetryAudio_Click" Content="重新连接" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="AudioPlaybackButton" Width="126" Click="PlayVoiceSample_Click" Content="试听录音" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="完成一次语音录音后，才能继续。" />
                    <Button x:Name="AudioContinueButton" Grid.Column="1" MinWidth="126" Click="AudioContinue_Click" Content="下一步  →" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="42">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Width="210" Height="118" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="#D3DAE2" BorderThickness="1" CornerRadius="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource AccentBrush}" Text="&#xE720;" />
                            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" Text="RC003MS · 16 kHz" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Height="126">
                        <Rectangle Width="2" Height="126" Fill="#B9CADB" />
                        <Border Width="62" Height="28" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="ATVV" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Width="260" Height="126" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#17202B" CornerRadius="26">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="#7DB8FF" Text="&#xE995;" />
                            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="CABLE Input" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#AEBAC8" Text="Windows 虚拟麦克风入口" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="VoiceStep" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*" />
                <ColumnDefinition Width="42*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="48,42,42,38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Margin="0,0,0,9" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="第 3 步 · 验证语音" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="听听遥控器刚才录到了什么" />
                    <TextBlock MaxWidth="570" Margin="0,12,0,0" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" LineHeight="24" Text="播放刚才保存的原始 16 kHz 录音。请亲自听一遍，确认录到的是自己的声音，完成真机验证。" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" Background="{StaticResource SuccessSoftBrush}" CornerRadius="24">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource SuccessBrush}" Text="&#xE720;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="已保存真机录音" />
                                <TextBlock x:Name="VoiceCaptureSummary" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="等待录音信息…" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="VoicePlaybackStatus" Margin="2,0,0,16" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="点击试听，确认录到的是你刚才说的话" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="VoicePlaybackButton" Width="150" Margin="0,0,10,0" Click="PlayVoiceSample_Click" Content="试听刚才录音" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="ConfirmVoiceButton" MinWidth="190" Click="ConfirmVoice_Click" Content="听到自己的声音，继续" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="录音直接在 VoiceAnything 内播放，不依赖文件关联或外部播放器。" />
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Ellipse Width="330" Height="330" Fill="#100F6CBD" />
                    <Border Width="270" Height="270" Background="{StaticResource SurfaceBrush}" BorderBrush="#D3DAE2" BorderThickness="1" CornerRadius="135">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="46" Foreground="{StaticResource AccentBrush}" Text="&#xE767;" />
                            <TextBlock Margin="0,18,0,0" FontSize="18" FontWeight="SemiBold" Text="试听并确认" />
                            <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="以你实际听到的声音为准" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ControlsStep" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" />
                <ColumnDefinition Width="58*" />
            </Grid.ColumnDefinitions>

            <Border Margin="34,22,22,28" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="RemoteHotspotStyle" TargetType="Button">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="#010F6CBD" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse x:Name="Hotspot" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hotspot" Property="Fill" Value="#440F6CBD" />
                                                <Setter TargetName="Hotspot" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="20,18,20,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="① 选择实体键" />
                        <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="点击图上按键，或直接按真机" />
                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="按下遥控器上的键，图中会选中对应位置。" />
                    </StackPanel>
                    <Canvas x:Name="RemoteHotspotCanvas" Grid.Row="1" Width="192" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="192" Height="400" Source="pack://application:,,,/VoiceAnything;component/Resources/RC003MS-remote-front-v2.png" Stretch="Uniform" />
                        <Button Canvas.Left="58" Canvas.Top="19" Tag="Power" ToolTip="电源键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="100" Canvas.Top="19" Tag="Microphone" ToolTip="麦克风键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="80" Canvas.Top="49" Tag="Up" ToolTip="方向上" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="56" Canvas.Top="73" Tag="Left" ToolTip="方向左" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="80" Canvas.Top="73" Tag="Ok" ToolTip="确认键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="104" Canvas.Top="73" Tag="Right" ToolTip="方向右" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="80" Canvas.Top="97" Tag="Down" ToolTip="方向下" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="62" Canvas.Top="127" Tag="Back" ToolTip="返回键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="98" Canvas.Top="127" Tag="VolumeUp" ToolTip="音量加" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="62" Canvas.Top="159" Tag="Home" ToolTip="主页键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="98" Canvas.Top="159" Tag="VolumeDown" ToolTip="音量减" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="62" Canvas.Top="192" Tag="Menu" ToolTip="菜单键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                        <Button Canvas.Left="98" Canvas.Top="192" Tag="Tv" ToolTip="电视键" Click="RemoteHotspot_Click" Style="{StaticResource RemoteHotspotStyle}" />
                    </Canvas>
                    <Border Grid.Row="2" Margin="18,0,18,16" Padding="12,9" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <TextBlock x:Name="SelectedHardwareLabel" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="尚未选择键位" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="22,22,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="第 4 步 · 个性化按键" />
                    <TextBlock Margin="0,6,0,0" FontSize="27" FontWeight="SemiBold" Text="选一个按键，设置它的动作" />
                    <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Text="先选按键，再选手势和动作。修改会自动保存。" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,18,0,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="13,10" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="① 选键位　→　② 选手势　→　③ 选功能" />
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="即时保存" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="起步模板" />
                                <TextBlock x:Name="ActivePresetText" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="当前起步模板：Codex" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="13,7" Tag="Codex" Click="Preset_Click" Content="应用 Codex" />
                                <Button Padding="13,7" Tag="Claude Code" Click="Preset_Click" Content="应用 Claude Code" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="当前编辑" />
                                <TextBlock x:Name="SelectedRemoteButtonTitle" Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Text="请点击左侧一个按键" />
                                <TextBlock x:Name="SelectedBindingDetail" Margin="0,5,0,12" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="选择后可设置单击、双击和长按动作" />
                                <StackPanel x:Name="TriggerPanel" Orientation="Horizontal">
                                    <Button x:Name="SingleTriggerButton" Margin="0,0,7,0" Tag="SingleClick" Click="Trigger_Click" Content="单击" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="0,0,7,0" Tag="DoubleClick" Click="Trigger_Click" Content="双击" />
                                    <Button Tag="LongPress" Click="Trigger_Click" Content="长按" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="BindingActionPanel" IsEnabled="False">
                            <TextBlock Margin="0,16,0,8" FontSize="13" FontWeight="SemiBold" Text="③ 为这个键选择功能" />
                            <TextBlock Margin="0,0,0,9" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="Codex 桌面动作使用官方 Windows 快捷键；在 Claude Code 或终端中不会误触。" TextWrapping="Wrap" />
                            <Border Margin="0,0,0,8" Padding="12,10,5,5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="对话与任务" />
                                    <WrapPanel>
                                        <Button Margin="0,0,7,7" Tag="SubmitTask" Click="BindingAction_Click" Content="发送任务" />
                                        <Button Margin="0,0,7,7" Tag="ApproveRequest" Click="BindingAction_Click" Content="批准请求" />
                                        <Button Margin="0,0,7,7" Tag="DeclineRequest" Click="BindingAction_Click" Content="拒绝请求" />
                                        <Button Margin="0,0,7,7" Tag="NewChat" Click="BindingAction_Click" Content="新建对话" />
                                        <Button Margin="0,0,7,7" Tag="NewStandaloneChat" Click="BindingAction_Click" Content="新建独立任务" />
                                        <Button Margin="0,0,7,7" Tag="PreviousChat" Click="BindingAction_Click" Content="上一个对话" />
                                        <Button Margin="0,0,7,7" Tag="NextChat" Click="BindingAction_Click" Content="下一个对话" />
                                        <Button Margin="0,0,7,7" Tag="NextChatNeedingAttention" Click="BindingAction_Click" Content="下一个待处理" />
                                        <Button Margin="0,0,7,7" Tag="FocusPrompt" Click="BindingAction_Click" Content="聚焦输入框" />
                                        <Button Margin="0,0,7,7" Tag="NewLine" Click="BindingAction_Click" Content="换行" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,0,8" Padding="12,10,5,5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="浏览与工作区" />
                                    <WrapPanel>
                                        <Button Margin="0,0,7,7" Tag="ScrollUp" Click="BindingAction_Click" Content="向上滚动" />
                                        <Button Margin="0,0,7,7" Tag="ScrollDown" Click="BindingAction_Click" Content="向下滚动" />
                                        <Button Margin="0,0,7,7" Tag="ContextUp" Click="BindingAction_Click" Content="智能上移" />
                                        <Button Margin="0,0,7,7" Tag="ContextDown" Click="BindingAction_Click" Content="智能下移" />
                                        <Button Margin="0,0,7,7" Tag="NavigatePrevious" Click="BindingAction_Click" Content="上一项" />
                                        <Button Margin="0,0,7,7" Tag="NavigateNext" Click="BindingAction_Click" Content="下一项" />
                                        <Button Margin="0,0,7,7" Tag="PreviousProject" Click="BindingAction_Click" Content="上一个运行项目" />
                                        <Button Margin="0,0,7,7" Tag="NextProject" Click="BindingAction_Click" Content="下一个运行项目" />
                                        <Button Margin="0,0,7,7" Tag="GoBack" Click="BindingAction_Click" Content="返回" />
                                        <Button Margin="0,0,7,7" Tag="OpenCommandMenu" Click="BindingAction_Click" Content="活动视图" />
                                        <Button Margin="0,0,7,7" Tag="OpenProjectPicker" Click="BindingAction_Click" Content="选择项目" />
                                        <Button Margin="0,0,7,7" Tag="ToggleSidebar" Click="BindingAction_Click" Content="侧边栏" />
                                        <Button Margin="0,0,7,7" Tag="ToggleTerminal" Click="BindingAction_Click" Content="终端" />
                                        <Button Margin="0,0,7,7" Tag="SearchFiles" Click="BindingAction_Click" Content="搜索文件" />
                                        <Button Margin="0,0,7,7" Tag="ToggleFileTree" Click="BindingAction_Click" Content="文件树" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,0,8" Padding="12,10,5,5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="AI 工作流" />
                                    <WrapPanel>
                                        <Button Margin="0,0,7,7" Tag="SelectModel" Click="BindingAction_Click" Content="选择模型" />
                                        <Button Margin="0,0,7,7" Tag="SelectReasoning" Click="BindingAction_Click" Content="切换推理强度" />
                                        <Button Margin="0,0,7,7" Tag="OpenReview" Click="BindingAction_Click" Content="打开审查" />
                                        <Button Margin="0,0,7,7" Tag="ToggleReviewPanel" Click="BindingAction_Click" Content="审查面板" />
                                        <Button Margin="0,0,7,7" Tag="OpenBrowser" Click="BindingAction_Click" Content="浏览器" />
                                        <Button Margin="0,0,7,7" Tag="OpenProjectTools" Click="BindingAction_Click" Content="项目工具" />
                                        <Button Margin="0,0,7,7" Tag="OpenSettings" Click="BindingAction_Click" Content="Codex 设置" />
                                        <Button Margin="0,0,7,7" Tag="InsertSkill" Click="BindingAction_Click" Content="插入 Skill" />
                                        <Button Margin="0,0,7,7" Tag="Find" Click="BindingAction_Click" Content="快捷查找" />
                                        <Button Margin="0,0,7,7" Tag="Undo" Click="BindingAction_Click" Content="快捷回滚" />
                                        <Button Margin="0,0,7,7" Tag="Redo" Click="BindingAction_Click" Content="重做" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Padding="12,10,5,5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="系统与安全" />
                                    <WrapPanel>
                                        <Button Margin="0,0,7,7" Tag="Escape" Click="BindingAction_Click" Content="取消/退出" />
                                        <Button Margin="0,0,7,7" Tag="VolumeUp" Click="BindingAction_Click" Content="系统音量加" />
                                        <Button Margin="0,0,7,7" Tag="VolumeDown" Click="BindingAction_Click" Content="系统音量减" />
                                        <Button Margin="0,0,7,7" Tag="Disabled" Click="BindingAction_Click" Content="不执行" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border x:Name="BindingArgumentCard" Margin="0,10,0,0" Padding="13" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="BindingArgumentTitle" FontSize="12" FontWeight="SemiBold" Text="动作参数" />
                                    <TextBox x:Name="BindingArgumentTextBox" Margin="0,7,8,0" Padding="9,7" FontSize="13" />
                                    <TextBlock x:Name="BindingArgumentHint" Margin="0,5,8,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Click="BindingArgumentSave_Click" Content="保存参数" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ControlsDetail" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="真机验证：请依次按下三个不同按键" TextWrapping="Wrap" />
                        <ProgressBar x:Name="ControlsProgress" Width="260" Height="6" Margin="0,7,0,0" HorizontalAlignment="Left" Maximum="3" Value="0" />
                    </StackPanel>
                    <Button x:Name="FinishButton" Grid.Column="1" Margin="12,0,0,0" Click="Finish_Click" Content="保存并启用" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
