<Window x:Class="SayAll.Windows.InsightsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Voice Anything · 记录" Width="1120" Height="800" MinWidth="850" MinHeight="650"
 Background="#F5F6F8" FontFamily="Segoe UI" FontSize="14" Foreground="#202633" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE0E6"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE0E6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E7E9ED"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid Margin="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Voice Anything" FontSize="13" Foreground="#858C98"/><TextBlock Text="使用记录" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock Text="统计和回眸保存在这台电脑。是否记录、授权哪些 Agent，由你决定。" Foreground="#687181"/></StackPanel>
   <Button Grid.Column="1" Content="刷新" Click="Refresh_Click" VerticalAlignment="Center"/>
  </Grid>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,20,0,0">
   <TabItem Header="使用统计" Padding="22,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Content="今天" Tag="day" Click="Range_Click"/><Button Content="本周" Tag="week" Click="Range_Click"/><Button Content="全部" Tag="all" Click="Range_Click"/><TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Foreground="#687181" Text="今天"/></StackPanel>
     <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-12,20">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="按键次数" Foreground="#687181"/><TextBlock x:Name="ButtonCountText" Text="0" FontSize="42" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="每次真实按下计一次" FontSize="12" Foreground="#858C98"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="语音时长" Foreground="#687181"/><TextBlock x:Name="VoiceTimeText" Text="0 秒" FontSize="42" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="按实际收到的音频计算" FontSize="12" Foreground="#858C98"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="语音会话" Foreground="#687181"/><TextBlock x:Name="SessionCountText" Text="0" FontSize="42" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="连续音频分段归为一次" FontSize="12" Foreground="#858C98"/></StackPanel></Border>
     </UniformGrid>
     <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="每日记录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
      <DataGrid Grid.Row="1" x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3" Background="White" BorderThickness="0" RowHeight="44" ColumnHeaderHeight="38">
       <DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="*"/><DataGridTextColumn Header="按键" Binding="{Binding ButtonPresses}" Width="*"/><DataGridTextColumn Header="语音秒数" Binding="{Binding VoiceSeconds, StringFormat=N1}" Width="*"/><DataGridTextColumn Header="会话" Binding="{Binding VoiceSessions}" Width="*"/></DataGrid.Columns>
      </DataGrid><TextBlock Grid.Row="1" x:Name="UsageEmpty" Text="还没有使用记录。连接遥控器后，按键和语音会自动记在这里。" Foreground="#858C98" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Border>
    </Grid>
   </TabItem>
   <TabItem Header="回眸" Padding="22,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel><CheckBox x:Name="RecordCheck" Content="保存 Voice Anything 触发的语音输入结果" Click="Privacy_Click" FontWeight="SemiBold"/><TextBlock Text="默认关闭。仅提取本次输入的新增文字；密码框、不支持的输入框或手动键入期间不记录。不会保存上下文和聊天记录。" Foreground="#687181" TextWrapping="Wrap" Margin="23,8,0,0" FontSize="12"/></StackPanel></Border>
     <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="142"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="搜索文字" FontSize="12" Foreground="#687181" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" ToolTip="搜索回眸文字" TextChanged="Search_Changed" Margin="0,0,10,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="应用名称" FontSize="12" Foreground="#687181" Margin="0,0,0,6"/><TextBox x:Name="ApplicationBox" ToolTip="应用名称（精确匹配，可留空）" TextChanged="Search_Changed" Margin="0,0,10,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="开始日期" FontSize="12" Foreground="#687181" Margin="0,0,0,6"/><DatePicker x:Name="FromDate" ToolTip="开始日期" SelectedDateChanged="Date_Changed" Margin="0,0,10,0"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="结束日期" FontSize="12" Foreground="#687181" Margin="0,0,0,6"/><DatePicker x:Name="ThroughDate" ToolTip="结束日期" SelectedDateChanged="Date_Changed"/></StackPanel>
     </Grid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><Grid>
      <DataGrid x:Name="ReflectionGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3" Background="White" BorderThickness="0" ColumnHeaderHeight="38" SelectionMode="Single">
       <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding EndedAt, StringFormat=MM-dd HH:mm}" Width="112"/><DataGridTextColumn Header="应用" Binding="{Binding Application}" Width="120"/><DataGridTemplateColumn Header="输入的文字" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="7,12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
      </DataGrid><TextBlock x:Name="ReflectionsEmpty" Text="尚无回眸记录。开启记录后，在支持的输入框中完成一次语音输入。" Foreground="#858C98" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap"/>
     </Grid></Border>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="复制选中" Click="CopyReflection_Click"/><Button Content="导出选中" Click="ExportReflection_Click"/><Button Content="删除选中" Click="DeleteReflection_Click"/><Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click"/><Button x:Name="MoreButton" Content="下一页" Click="More_Click"/></StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Agent 访问" Padding="22,10">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="本地 Agent 访问" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="提供本地只读 MCP：搜索回眸、读取单条记录、列出应用、查询使用统计。没有文件访问、执行命令或修改记录的工具。" Foreground="#687181" TextWrapping="Wrap" Margin="0,10,0,18"/><CheckBox x:Name="AgentCheck" Content="允许已授权的本地 Agent 读取" Click="Privacy_Click"/><TextBlock Text="关闭后，已有连接也会停止读取。第三方 Agent 可能把读取内容发送给其云端模型。" Foreground="#687181" FontSize="12" Margin="23,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="客户端授权" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><DockPanel><Button DockPanel.Dock="Right" Content="生成连接配置" Click="Grant_Click"/><TextBox x:Name="ClientNameBox" Text="我的 Agent" Margin="0,0,12,0" MaxLength="80"/></DockPanel>
      <ListBox x:Name="GrantList" DisplayMemberPath="Name" Margin="0,16,0,12" MinHeight="70" BorderBrush="#DCE0E6"/><Button Content="撤销选中客户端" Click="Revoke_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接配置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="连接配置只在本次窗口中显示，请复制到支持 MCP 的客户端。授权码请勿分享或提交到仓库。" Foreground="#687181" FontSize="12" Margin="0,8,0,14" TextWrapping="Wrap"/><TextBox x:Name="McpConfigBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" FontFamily="Consolas" FontSize="12"/><Button Content="复制连接配置" Click="CopyConfig_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="所有数据保存在本机" Foreground="#687181" Margin="0,18,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
