<Window x:Class="SayAll.Windows.DevicesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Voice Anything · 设备" Width="900" Height="670" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F5F6F8" FontFamily="Segoe UI" FontSize="14" Foreground="#202633">
 <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE0E6"/><Setter Property="Margin" Value="0,0,10,0"/></Style></Window.Resources>
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,25"><TextBlock Text="设备与型号" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="先选择型号，再选择已配对的设备。连接前会核对设备报告的型号与语音能力。" Foreground="#687181" Margin="0,8,0,18"/><StackPanel Orientation="Horizontal"><Button Content="扫描已配对设备" Click="Scan_Click"/><Button Content="导入型号包" Click="Import_Click"/><Button Content="Windows 蓝牙设置" Click="Bluetooth_Click"/></StackPanel></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="01  选择型号" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox Grid.Row="1" x:Name="ProfileList" BorderThickness="0" DisplayMemberPath="Profile.Name" SelectionChanged="Profile_Changed"/><TextBlock Grid.Row="2" x:Name="CapabilityText" TextWrapping="Wrap" Foreground="#687181" Margin="0,14,0,0"/></Grid></Border>
   <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="02  选择实际设备" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox Grid.Row="1" x:Name="DeviceList" BorderThickness="0" DisplayMemberPath="Name"/><TextBlock Grid.Row="2" Text="名称只用于选择，型号以设备实际报告为准。语音与按键会绑定到同一设备。" TextWrapping="Wrap" Foreground="#687181" Margin="0,14,0,0"/></Grid></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="还未扫描设备" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#687181" Margin="0,0,20,0"/><Button Grid.Column="1" x:Name="ConnectButton" Content="验证并使用" Click="Connect_Click" Background="#FFEEE5" BorderBrush="#EEBDA4"/></Grid>
 </Grid>
</Window>
